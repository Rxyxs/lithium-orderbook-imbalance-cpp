# Build outputs
bin/
*.exe
*.obj
*.pdb
*.ilk
*.exp
*.lib

# Generated results
results.csv
*.results.csv

# Full generated datasets are large (~26MB) and fully reproducible via
# `.\build.ps1 -GenData` (seed 42) -- only small previews are tracked.
data/*.csv
!data/*_preview.csv

# MSVC / Visual Studio
.vs/
*.vcxproj.user
CMakeFiles/
CMakeCache.txt

# CLAUDE.md is a personal working-notes file, not part of the published project
CLAUDE.md

# OS noise
Thumbs.db
.DS_Store

# Test scratch files (tests/test_engine.cpp cleans these up itself,
# but an interrupted run can leave them behind)
test_tmp_*.csv
